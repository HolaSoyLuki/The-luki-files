import os
import math
startVal = 1000000
increaseVal = 2.5
timeSim = 100
curVal = startVal
infoLog = {}

for x in range(1, timeSim):
    infoLog[x] = 0

infoLog[1] = startVal

def cleanNum(num):
    cleaned1 = f'{num:,}'
    cleaned2 = cleaned1.replace(".", ";")
    cleaned3 = cleaned2.replace(",", ".")
    cleaned4 = cleaned3.replace(";", ",")
    return cleaned4

def getPrintT(infoT):
    printT = "Info per year: \n"
    for i, x in infoT.items():
        printT += "\nYear " + str(i) + ": " + str(cleanNum(x)) + " euros"
    printT += "\n\nValues:\nStarting value: " + str(cleanNum(startVal)) + " euros\nIncrease per year: " + str(increaseVal) + "%\nTime simulation: " + str(timeSim) + " years"
    return printT

def calPer(coorVal):
    nonRoundVal = coorVal + (coorVal * (increaseVal / 100))
    roundVal = (math.floor(nonRoundVal * 100)) / 100
    return roundVal

for x in range(1, timeSim):
    curVal = calPer(curVal)
    infoLog[x + 1] = curVal

dir_path = os.path.join(os.getcwd(), "Results")
os.makedirs(dir_path, exist_ok=True)

count = len([f for f in os.listdir(dir_path) if os.path.isfile(os.path.join(dir_path, f))])
file_name = f"Results {timeSim} rounds {count + 1}.txt"
file_path = os.path.join(dir_path, file_name)

with open(file_path, "x") as resultF:
    resultF.write(getPrintT(infoLog))
